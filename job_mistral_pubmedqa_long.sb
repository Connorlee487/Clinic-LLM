#!/bin/bash
#SBATCH --job-name=mistral_pubmedqa
#SBATCH --account=beqz-delta-gpu
#SBATCH --partition=gpuA40x4
#SBATCH --gpus-per-node=1
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32g
#SBATCH --time=10:00:00
#SBATCH --output=mistral_pubmedqa_%j.out
#SBATCH --mail-type=END,FAIL
source /sw/rh9.4/python/miniforge3/etc/profile.d/conda.sh
conda activate "${CONDA_ENV:-medical-llm}"
cd -- "$(dirname -- "$0")"
python run_all_attacks.py --model mistral --dataset pubmedqa --resume
